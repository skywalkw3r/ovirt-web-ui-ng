    "@patternfly/react-table": "^6.7.0",
    "@patternfly/react-tokens": "^6.6.1",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-virtual": "^3.14.21",
    "cmdk": "^1.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-intl": "^12.1.5",
    "victory-area": "^37.3.6",
    "victory-axis": "^37.3.6",
    "victory-bar": "^37.3.6",
    "victory-box-plot": "^37.3.6",
