{
  "name": "ovirt-web-ui-ng",
  "private": true,
  "version": "0.1.0-beta.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_MOCK=1 vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint && prettier --check src",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "format": "prettier --write src",
    "preview": "vite preview",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "verify:engine": "node ../scripts/verify-live-engine.mjs",
    "deploy:engine": "bash ../scripts/deploy-engine.sh",
    "promote:prod": "bash ../scripts/promote-prod.sh"
  },
  "dependencies": {
    "@novnc/novnc": "^1.7.0",
    "@patternfly/react-core": "^6.7.0",
    "@patternfly/react-icons": "^6.6.1",
    "@patternfly/react-table": "^6.7.0",
    "@patternfly/react-tokens": "^6.6.1",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-virtual": "^3.14.24",
    "cmdk": "^1.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-intl": "^12.1.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
