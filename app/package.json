{
  "name": "ovirt-web-ui-ng",
  "private": true,
  "version": "0.1.0-beta.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_MOCK=1 vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint && prettier --check src",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "format": "prettier --write src",
    "preview": "vite preview",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "verify:engine": "node ../scripts/verify-live-engine.mjs",
    "deploy:engine": "bash ../scripts/deploy-engine.sh",
    "promote:prod": "bash ../scripts/promote-prod.sh"
  },
  "dependencies": {
